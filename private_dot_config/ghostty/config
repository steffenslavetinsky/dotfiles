# Font
font-family = MesloLGS NF
font-size = 14

# Window
macos-titlebar-style = tabs
window-theme = auto

# Default colors (warm white)
background = #f5f5f0
foreground = #2e3440

# Cursor
cursor-style = block
cursor-style-blink = true
cursor-color = #ff10f0
cursor-text = #1e1e2e
shell-integration-features = no-cursor

# New windows/tabs inherit working directory
window-inherit-working-directory = true

# Keybindings
keybind = cmd+shift+t=new_window

# Theme
theme = Catppuccin Frappe


